<Window x:Class="NetworkDownloader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="指定网络下载器 · 任务中心" Width="1120" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" FontFamily="Microsoft YaHei UI" FontSize="12"
        Foreground="{StaticResource Ink}" UseLayoutRounding="True" Closing="Window_Closing" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="DetailLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="Margin" Value="0,0,0,4" /><Setter Property="FontSize" Value="11" /></Style>
        <Style x:Key="DetailValue" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="Margin" Value="0,0,18,0" /></Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" /><Setter Property="Margin" Value="0,2" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Chrome" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#EDF1F7" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E8EEFF" /><Setter Property="Foreground" Value="#315FD8" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Outline}" BorderThickness="0,0,0,1" Padding="22,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Background="{StaticResource Accent}" CornerRadius="9" VerticalAlignment="Center"><Path Data="{StaticResource DownloadIcon}" Stroke="White" StrokeThickness="1.7" Stretch="Uniform" Width="18" Height="18" /></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0"><TextBlock Text="指定网络下载器" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="任务中心 · HTTP / BitTorrent" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" /></StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding TotalSpeed}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <Button Grid.Column="3" Content="＋ 新建下载" Style="{StaticResource PrimaryButton}" Click="New_Click" IsEnabled="{Binding Ready}" VerticalAlignment="Center" Padding="14,4" />
            </Grid>
        </Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="156" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border BorderBrush="{StaticResource Outline}" BorderThickness="0,0,1,0" Padding="10,20,10,12">
                <DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="10,0,0,0"><TextBlock Text="并行任务 3 · BT 1" Foreground="{StaticResource Muted}" FontSize="11" /><TextBlock Text="指定网卡 · 独立断点" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" /></StackPanel>
                    <StackPanel><TextBlock Text="下载管理" Foreground="{StaticResource Muted}" FontSize="11" Margin="12,0,0,12" />
                        <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" VirtualizingPanel.IsVirtualizing="False">
                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" Text="{Binding Count}" Opacity="0.75" /></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="18,20,18,14"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Heading}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Grid Grid.Column="2"><TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索任务名称或网卡" AutomationProperties.Name="搜索任务名称或网卡" /><TextBlock Text="搜索任务 / 网卡" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                    <Button Grid.Column="3" Content="暂停全部" Margin="8,0,0,0" Command="{Binding PauseAllCommand}" IsEnabled="{Binding Ready}" />
                </Grid>
                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                    <Grid>
                        <DataGrid x:Name="TaskList" ItemsSource="{Binding TaskView}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False" RowHeight="68" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1F6" BorderThickness="0" Background="White" RowBackground="White" AlternatingRowBackground="White" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F8FAFD" /><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="Padding" Value="12,11" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{StaticResource Outline}" /><Setter Property="FontSize" Value="11" /></Style>
                                <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="12,5" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" /></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EDF2FF" /><Setter Property="Foreground" Value="{StaticResource Ink}" /></Trigger></Style.Triggers></Style>
                                <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{StaticResource Ink}" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F7F9FE" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EDF2FF" /></Trigger></Style.Triggers></Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="任务名称 / 使用网络" Width="*" MinWidth="180" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontWeight="Medium" /><TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" /></StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="状态" Width="90" SortMemberPath="Status"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" VerticalAlignment="Center" FontSize="11" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="下载进度" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding PercentText}" FontSize="11" /><ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,5,0,4" Foreground="{Binding ProgressColor}" IsIndeterminate="{Binding Indeterminate}" /><TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="速度 / 时间" Width="148"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding TimingToolTip}">
                                        <TextBlock Text="{Binding Rate}" FontSize="11" Foreground="{StaticResource Accent}" />
                                        <TextBlock Text="{Binding RemainingText}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ElapsedText}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="操作" Width="86"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding PrimaryAction}" Command="{Binding DataContext.PrimaryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding CanPrimary}" FontSize="11" Padding="8,4" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Empty, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="暂无任务" FontSize="17" Foreground="#7C8BA3" HorizontalAlignment="Center" /><TextBlock Text="新建下载，或切换分类查看已有任务" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <DockPanel Grid.Row="2" Margin="0,10,0,10" IsEnabled="{Binding Ready}">
                    <TextBlock DockPanel.Dock="Right" Text="Ctrl / Shift 多选" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="继续所选" Command="{Binding ResumeSelectedCommand}" CommandParameter="{Binding SelectedItems, ElementName=TaskList}" Margin="0,0,6,0" />
                        <Button Content="暂停所选" Command="{Binding PauseSelectedCommand}" CommandParameter="{Binding SelectedItems, ElementName=TaskList}" Margin="0,0,6,0" />
                        <Button Content="更换网卡" Click="Rebind_Click" Margin="0,0,6,0" IsEnabled="{Binding Selected.CanRebind}" />
                        <Button Content="移除记录" Click="Remove_Click" ToolTip="仅移除任务记录，不删除下载文件和断点" Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </DockPanel>
                <Expander x:Name="DetailsExpander" Grid.Row="3" Header="任务详情" ToolTip="收起详情可显示更多任务" IsExpanded="True" Foreground="{StaticResource Muted}">
                    <Border Background="White" BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="9" Padding="15,12" Margin="0,7,0,0">
                        <Grid MinHeight="117">
                            <TextBlock Text="选择任务查看目录、网络和恢复信息" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,11"><Button DockPanel.Dock="Right" Content="打开目录" Click="Folder_Click" Height="28" MinHeight="28" FontSize="11" /><TextBlock Text="{Binding Selected.Name}" ToolTip="{Binding Selected.Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ink}" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,12,0" /></DockPanel>
                                <StackPanel Grid.Row="1" Margin="0,0,0,10"><TextBlock Text="保存位置" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding Selected.OutputPath}" ToolTip="{Binding Selected.OutputPath}" Style="{StaticResource DetailValue}" /></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"><TextBlock Text="使用网络" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding Selected.Network}" ToolTip="{Binding Selected.Network}" Style="{StaticResource DetailValue}" /></StackPanel>
                                <StackPanel Grid.Row="2"><TextBlock Text="状态 / 恢复信息" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding Selected.Message}" ToolTip="{Binding Selected.Message}" Style="{StaticResource DetailValue}" Foreground="{Binding Selected.StatusColor}" /></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="{Binding Selected.Connections}" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding Selected.CreatedText, StringFormat=创建时间：{0}}" Style="{StaticResource DetailValue}" /></StackPanel>
                                <StackPanel Grid.Row="3" Margin="0,11,0,0" ToolTip="{Binding Selected.TimingToolTip}"><TextBlock Text="累计执行用时" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding Selected.ElapsedDetail}" Style="{StaticResource DetailValue}" /></StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,11,0,0" ToolTip="{Binding Selected.TimingToolTip}"><TextBlock Text="{Binding Selected.RemainingText}" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding Selected.EstimatedCompletionText, StringFormat=预计传输完成：{0}}" Style="{StaticResource DetailValue}" /></StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Expander>
            </Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{StaticResource Outline}" BorderThickness="0,1,0,0" Background="White" Padding="18,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,20,0" /><TextBlock Grid.Column="1" Text="{Binding Notice}" ToolTip="{Binding Notice}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="11" />
        </Grid></Border>
    </Grid>
</Window>
