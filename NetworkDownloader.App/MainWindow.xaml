<Window x:Class="NetworkDownloader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="指定网络下载器" Width="820" Height="660" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" FontFamily="Microsoft YaHei UI" FontSize="12"
        Foreground="{StaticResource Ink}" UseLayoutRounding="True" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium" /><Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="#42516A" />
        </Style>
        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1.7" /><Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" /><Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
    </Window.Resources>
    <Grid Margin="20,18,14,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,8,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource Accent}" VerticalAlignment="Center">
                <Path Data="{StaticResource DownloadIcon}" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="19" Height="19" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="指定网络下载器" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="选择网络，让下载更从容" Foreground="{StaticResource Muted}" Margin="0,3,0,0" FontSize="11" />
            </StackPanel>
            <Border Grid.Column="2" Background="#EAF0FF" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                <TextBlock Text="多连接下载" Foreground="#4264B4" FontSize="11" />
            </Border>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="0,0,8,0">
            <StackPanel>
                <Border Background="White" CornerRadius="12" Padding="18,16" BorderBrush="#E7ECF4" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="下载设置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <TextBlock Text="下载地址" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="UrlBox" ToolTip="HTTP 或 HTTPS 文件直链" TextChanged="Url_TextChanged" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition Width="136" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="使用的网络" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="AdapterBox" ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click" Margin="6,0,0,0" Width="32" Padding="8"
                                            ToolTip="刷新网卡" AutomationProperties.Name="刷新网卡">
                                        <Path Data="{StaticResource RefreshIcon}" Style="{StaticResource Icon}" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="下载连接数" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ConnectionBox" SelectedIndex="2">
                                    <ComboBoxItem Tag="1" Content="1 · 单连接" /><ComboBoxItem Tag="2" Content="2 · 双连接" />
                                    <ComboBoxItem Tag="4" Content="4 · 推荐" /><ComboBoxItem Tag="8" Content="8 · 多连接" />
                                    <ComboBoxItem Tag="16" Content="16 · 多连接" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="保存到（目录）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="PathBox" ToolTip="下载文件的保存目录" />
                            <Button x:Name="BrowseButton" Grid.Column="1" Click="Browse_Click" Margin="6,0,0,0" AutomationProperties.Name="选择目录">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource FolderIcon}" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="选择目录" /></StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="FileNameText" Text="文件名：输入下载地址后自动识别" Foreground="{StaticResource Muted}" FontSize="11" Margin="1,8,0,0" TextWrapping="Wrap" />
                        <Border Height="1" Background="#EFF2F7" Margin="0,14,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Click="Start_Click" MinWidth="142" Padding="13,4" AutomationProperties.Name="开始下载 / 继续">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource DownloadIcon}" Style="{StaticResource Icon}" Margin="0,0,9,0" /><TextBlock Text="开始下载 / 继续" /></StackPanel>
                            </Button>
                            <Button x:Name="PauseButton" Grid.Column="1" Click="Pause_Click" IsEnabled="False" Margin="8,0,0,0" Padding="11,4" AutomationProperties.Name="暂停">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource PauseIcon}" Style="{StaticResource Icon}" Width="12" Margin="0,0,8,0" /><TextBlock Text="暂停" /></StackPanel>
                            </Button>
                            <Button x:Name="FolderButton" Grid.Column="3" Style="{StaticResource GhostButton}" Click="Folder_Click" Padding="8,4" AutomationProperties.Name="打开目录">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource FolderIcon}" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="打开目录" /></StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="18,16" Margin="0,12,0,2" BorderBrush="#E7ECF4" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="StatusText" Text="等待下载" FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,12,0" />
                                <TextBlock x:Name="DetailsText" Text="0 B / — · 0 B/s" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar x:Name="DownloadBar" Minimum="0" Maximum="100" Height="6" Margin="0,13,0,10" />
                        <TextBlock x:Name="NetworkText" Text="选择网络后即可开始下载" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="2,11,10,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="自动命名 · 断点续传 · 同名文件不覆盖" Foreground="#8A97AB" FontSize="11" />
            <TextBlock Grid.Column="1" Text="所有连接使用所选网卡" Foreground="#8A97AB" FontSize="11"
                       ToolTip="支持 IPv4 HTTP/HTTPS；DNS 使用系统解析。服务器不支持分片时自动使用单连接。" />
        </Grid>
    </Grid>
</Window>
