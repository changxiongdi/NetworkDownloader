<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NetworkDownloader.Core/NetworkDownloader.Core.csproj" />
    <None Include="../artifacts/native-build/Release/NetworkDownloader.Native.dll" Link="NetworkDownloader.Native.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../artifacts/native-build/Release/NetworkDownloader.Native.dll')" />
  </ItemGroup>
  <Target Name="GetWorkerPayload" Returns="@(_WorkerPayload)">
    <ItemGroup><_WorkerPayload Include="$(TargetDir)*.dll;$(TargetDir)*.exe;$(TargetDir)*.json" /></ItemGroup>
  </Target>
</Project>
